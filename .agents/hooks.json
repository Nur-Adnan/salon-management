{
  "safety-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/pre-tool-safety.js",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "post-edit-gate": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "replace_file_content|multi_replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/post-edit-check.js",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
